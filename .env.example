# Copy this file to .env.local for local development.
# Never commit a file containing real values.

# --- WordPress headless CMS -------------------------------------------------
# Base REST API URL of your WordPress install, e.g. https://cms.strategro.com/wp-json/wp/v2
# Leave unset to use local sample blog content instead.
WORDPRESS_API_URL=

# --- Public site configuration ----------------------------------------------
# Canonical URL of this deployment (no trailing slash). Used for metadata,
# canonical tags, Open Graph URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.strategro.com

# Calendly (or similar) booking link, used as a fallback CTA when the
# contact form's webhook isn't configured.
NEXT_PUBLIC_CALENDLY_URL=

# --- Lead capture (n8n) ------------------------------------------------------
# Server-only. Never exposed to the browser. Leave unset to show a mailto/
# booking fallback on the contact page instead of the form.
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_SECRET=

# --- Analytics ---------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
