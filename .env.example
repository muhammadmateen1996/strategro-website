# Copy this file to .env.local for local development.
# Never commit a file containing real values.

# --- WordPress headless CMS -------------------------------------------------
# Base REST API URL of your WordPress install, e.g. https://cms.strategro.com/wp-json/wp/v2
# Leave unset to use local sample blog content instead.
WORDPRESS_API_URL=

# --- Public site configuration ----------------------------------------------
# Canonical URL of this deployment (no trailing slash). Used for metadata,
# canonical tags, Open Graph URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.strategro.co.uk

# --- Clara (chat, contact form, booking) ------------------------------------
# All three default to Strategro's live Clara instance in lib/site-config.ts,
# so these only need setting if that changes.
# Publishable key for the site-wide chat widget script (safe to expose client-side).
NEXT_PUBLIC_CLARA_CHAT_KEY=
# Clara embeddable form URL, used on /contact.
NEXT_PUBLIC_CLARA_FORM_URL=
# Clara embeddable booking/calendar URL, used on /contact.
NEXT_PUBLIC_CLARA_BOOKING_URL=

# --- Analytics ---------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
